---
import { LIB } from '../i18n/library';

export interface Props {
  /** Turnstile 사이트 키 (공개값). 비우면 보안문자가 나오지 않는다. */
  siteKey: string;
}
const { siteKey } = Astro.props;
const t = LIB.ru;
---

<div class="contain member-box">
  <p class="lead">{t.loginNeeded}</p>

  <form id="loginForm" autocomplete="on">
    <div class="row">
      <label for="username">{t.idLabel}</label>
      <input type="text" id="username" name="username" class="input" autocomplete="username"
             placeholder={t.idLabel} required />
    </div>
    <div class="row">
      <label for="password">{t.pwLabel}</label>
      <input type="password" id="password" name="password" class="input" autocomplete="current-password"
             placeholder={t.pwLabel} required />
    </div>

    <div class="row save">
      <label><input type="checkbox" id="saveId" /> {t.saveId}</label>
    </div>

    {/* 로그인을 여러 번 틀린 뒤에만 나타난다 */}
    <div class="row captcha" id="captchaRow" hidden>
      <div class="cf-turnstile" data-sitekey={siteKey} data-callback="bkCaptchaDone" data-language="ru"></div>
    </div>

    <p class="msg" id="msg" role="alert" hidden></p>

    <div class="buttons">
      <button type="submit" class="btn-pack big focus" id="submitBtn">{t.loginBtn}</button>
    </div>
  </form>

  <p class="alt"><a href="/ru/member/join">{t.toJoin}</a></p>
</div>

{siteKey && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<script is:inline define:vars={{ M: { failed: t.loginFailed, required: t.required, captcha: t.captchaNeeded, error: t.serverError } }}>
  (function () {
    var form = document.getElementById('loginForm');
    var msg = document.getElementById('msg');
    var btn = document.getElementById('submitBtn');
    var captchaRow = document.getElementById('captchaRow');
    var saveId = document.getElementById('saveId');
    var idInput = document.getElementById('username');
    var captchaToken = '';

    window.bkCaptchaDone = function (token) { captchaToken = token; };

    // 아이디 저장 (이 브라우저에만 남는다)
    try {
      var saved = localStorage.getItem('bk_saved_id');
      if (saved) { idInput.value = saved; saveId.checked = true; }
    } catch (e) {}

    function show(text) { msg.textContent = text; msg.hidden = false; }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      msg.hidden = true;

      var username = idInput.value.trim();
      var password = document.getElementById('password').value;
      if (!username || !password) { show(M.required); return; }

      btn.disabled = true;
      try {
        var r = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username, password: password, captcha: captchaToken }),
        });
        var j = await r.json();

        if (j.ok) {
          try {
            if (saveId.checked) localStorage.setItem('bk_saved_id', username);
            else localStorage.removeItem('bk_saved_id');
          } catch (e) {}
          var next = new URLSearchParams(location.search).get('next') || '/ru/library';
          location.href = next;
          return;
        }

        // 여러 번 틀리면 보안문자를 띄운다
        if (j.needCaptcha && captchaRow) {
          captchaRow.hidden = false;
          if (window.turnstile) window.turnstile.reset();
        }
        show(j.code === 'CAPTCHA' ? M.captcha : M.failed);
      } catch (err) {
        show(M.error);
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .member-box { max-width: 460px; margin: 0 auto; padding: 60px 0 100px; }
  .lead { color: #555; font-size: 15px; margin-bottom: 28px; text-align: center; }
  .row { margin-bottom: 14px; }
  .row label { display: block; font-size: 14px; color: #333; margin-bottom: 6px; }
  .row .input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    border: 1px solid #d5dbe3;
    font-size: 15px;
    box-sizing: border-box;
  }
  .row.save label { display: inline; font-size: 14px; color: #555; }
  .row.captcha { margin: 18px 0; }
  .msg { color: #c8102e; font-size: 14px; margin: 10px 0; }
  .buttons { margin-top: 22px; }
  .buttons .btn-pack { width: 100%; }
  .alt { margin-top: 22px; text-align: center; font-size: 14px; }
  .alt a { color: #1f3d6e; text-decoration: underline; }
</style>
