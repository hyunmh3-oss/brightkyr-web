---
import { LIB } from '../i18n/library';
import { prefix, type Lang } from '../i18n/nav';

export interface Props {
  lang: Lang;
  /** Turnstile 사이트 키 (공개값) */
  siteKey: string;
}
const { lang, siteKey } = Astro.props;
const t = LIB[lang];
const p = prefix(lang);
---

<div class="contain member-box">
  <form id="joinForm" autocomplete="on">
    <div class="row">
      <label for="username">{t.idLabel}</label>
      <input type="text" id="username" name="username" class="input" autocomplete="username"
             pattern="[A-Za-z0-9]{4,20}" required />
      <p class="hint">{t.idRule}</p>
    </div>

    <div class="row">
      <label for="name">{t.nameLabel}</label>
      <input type="text" id="name" name="name" class="input" autocomplete="name" required />
    </div>

    <div class="row">
      <label for="email">{t.emailLabel}</label>
      <input type="email" id="email" name="email" class="input" autocomplete="email" required />
    </div>

    <div class="row">
      <label for="password">{t.pwLabel}</label>
      <input type="password" id="password" name="password" class="input" autocomplete="new-password"
             minlength="10" required />
      <p class="hint">{t.pwTooShort}</p>
    </div>

    <div class="row">
      <label for="password2">{t.pwConfirm}</label>
      <input type="password" id="password2" name="password2" class="input" autocomplete="new-password" required />
    </div>

    <div class="agree">
      <label class="all"><input type="checkbox" id="agreeAll" /> <strong>{t.agreeAll}</strong></label>
      <label>
        <input type="checkbox" class="agree-item" required /> {t.agreeTerms}
        <a href={`${p}/sub/pop_email.html`} target="_blank" rel="noopener" class="more">{t.detail}</a>
      </label>
      <label>
        <input type="checkbox" class="agree-item" required /> {t.agreePrivacy}
        <a href={`${p}/sub/pop_privacy.html`} target="_blank" rel="noopener" class="more">{t.detail}</a>
      </label>
    </div>

    <div class="row captcha">
      <div class="cf-turnstile" data-sitekey={siteKey} data-callback="bkCaptchaDone" data-language={lang}></div>
    </div>

    <p class="msg" id="msg" role="alert" hidden></p>

    <div class="buttons">
      <button type="submit" class="btn-pack big focus" id="submitBtn">{t.joinBtn}</button>
    </div>
  </form>

  <p class="alt"><a href={`${p}/member/login`}>{t.toLogin}</a></p>
</div>

<script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>

<script is:inline define:vars={{ LOGIN_URL: `${p}/member/login`, M: {
  required: t.required, mismatch: t.pwMismatch, short: t.pwTooShort, taken: t.idTaken,
  idRule: t.idRule, captcha: t.captchaNeeded, captchaFail: t.captchaFailed,
  joined: t.joined, error: t.serverError
} }}>
  (function () {
    var form = document.getElementById('joinForm');
    var msg = document.getElementById('msg');
    var btn = document.getElementById('submitBtn');
    var agreeAll = document.getElementById('agreeAll');
    var items = Array.prototype.slice.call(document.querySelectorAll('.agree-item'));
    var captchaToken = '';

    window.bkCaptchaDone = function (token) { captchaToken = token; };

    // 전체 동의 ↔ 개별 동의 연동
    agreeAll.addEventListener('change', function () {
      items.forEach(function (c) { c.checked = agreeAll.checked; });
    });
    items.forEach(function (c) {
      c.addEventListener('change', function () {
        agreeAll.checked = items.every(function (x) { return x.checked; });
      });
    });

    function show(text, good) {
      msg.textContent = text;
      msg.hidden = false;
      msg.classList.toggle('good', !!good);
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      msg.hidden = true;

      var username = document.getElementById('username').value.trim();
      var name = document.getElementById('name').value.trim();
      var email = document.getElementById('email').value.trim();
      var pw = document.getElementById('password').value;
      var pw2 = document.getElementById('password2').value;

      if (!username || !name || !email || !pw) { show(M.required); return; }
      if (!/^[A-Za-z0-9]{4,20}$/.test(username)) { show(M.idRule); return; }
      if (pw.length < 10) { show(M.short); return; }
      if (pw !== pw2) { show(M.mismatch); return; }
      if (!items.every(function (c) { return c.checked; })) { show(M.required); return; }
      if (!captchaToken) { show(M.captcha); return; }

      btn.disabled = true;
      try {
        var r = await fetch('/api/auth/join', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username: username, name: name, email: email, password: pw, captcha: captchaToken }),
        });
        var j = await r.json();

        if (j.ok) {
          show(M.joined, true);
          setTimeout(function () { location.href = LOGIN_URL; }, 1200);
          return;
        }

        if (window.turnstile) { window.turnstile.reset(); captchaToken = ''; }
        if (j.code === 'ID_TAKEN') show(M.taken);
        else if (j.code === 'ID_RULE') show(M.idRule);
        else if (j.code === 'PW_SHORT') show(M.short);
        else if (j.code === 'CAPTCHA') show(M.captchaFail);
        else show(M.required);
      } catch (err) {
        show(M.error);
      } finally {
        btn.disabled = false;
      }
    });
  })();
</script>

<style>
  .member-box { max-width: 460px; margin: 0 auto; padding: 60px 0 100px; }
  .row { margin-bottom: 14px; }
  .row label { display: block; font-size: 14px; color: #333; margin-bottom: 6px; }
  .row .input {
    width: 100%;
    height: 46px;
    padding: 0 14px;
    border: 1px solid #d5dbe3;
    font-size: 15px;
    box-sizing: border-box;
  }
  .hint { font-size: 13px; color: #888; margin-top: 5px; }
  .agree {
    margin: 24px 0 18px;
    padding: 16px 18px;
    background: #f4f6f9;
    border: 1px solid #e5e9ef;
  }
  .agree label { display: block; font-size: 14px; color: #444; margin-bottom: 9px; }
  .agree label.all { padding-bottom: 9px; border-bottom: 1px solid #e0e5ec; margin-bottom: 12px; }
  .agree .more { margin-left: 6px; color: #1f3d6e; text-decoration: underline; font-size: 13px; }
  .row.captcha { margin: 18px 0; }
  .msg { color: #c8102e; font-size: 14px; margin: 10px 0; }
  .msg.good { color: #1f7a3d; }
  .buttons { margin-top: 22px; }
  .buttons .btn-pack { width: 100%; }
  .alt { margin-top: 22px; text-align: center; font-size: 14px; }
  .alt a { color: #1f3d6e; text-decoration: underline; }
</style>
