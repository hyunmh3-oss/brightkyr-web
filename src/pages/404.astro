---
import Base from '../layouts/Base.astro';

/**
 * 없는 주소로 들어왔을 때 보여줄 화면.
 * 어느 언어에서 들어왔는지 알 수 없으므로 4개 언어를 함께 적는다.
 */
const lines = [
  { lang: 'ko', text: '요청하신 페이지를 찾을 수 없습니다.' },
  { lang: 'en', text: 'The page you requested was not found.' },
  { lang: 'ky', text: 'Сурап жаткан барак табылган жок.' },
  { lang: 'ru', text: 'Запрошенная страница не найдена.' },
];
const links = [
  { label: '한국어', href: '/' },
  { label: 'English', href: '/en/' },
  { label: 'Кыргызча', href: '/ky/' },
  { label: 'Русский', href: '/ru/' },
];
---

<Base lang="ko" title="404" heading="404" breadcrumb="" path="/">
  <div class="contain notfound">
    <p class="code">404</p>
    {lines.map((l) => (
      <p class="msg" lang={l.lang}>{l.text}</p>
    ))}
    <div class="go">
      {links.map((l) => (
        <a href={l.href} class="btn-pack medium">{l.label}</a>
      ))}
    </div>
  </div>
</Base>

<style>
  .notfound { padding: 80px 20px 120px; text-align: center; }
  .code { font-size: 72px; font-weight: 800; color: #1f3d6e; line-height: 1; margin-bottom: 24px; }
  .msg { font-size: 16px; color: #555; margin-bottom: 6px; }
  .go { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; margin-top: 36px; }
</style>
